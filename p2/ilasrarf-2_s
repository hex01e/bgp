# Router2 Static VXLAN Configuration
# eth0: connects to switch (10.1.1.2/30)
# eth1: connects to host2
# vxlan10: VXLAN tunnel to router1
# br0: bridge connecting eth1 and vxlan10

# Step 1 - Configure interfaces
ip link set eth0 up
ip addr add 10.1.1.2/30 dev eth0
ip link set eth1 up

# Step 2 - Create VXLAN tunnel (static)
# remote = router1's IP (opposite of router1!)
ip link add vxlan10 type vxlan \
    id 10 \
    remote 10.1.1.1 \
    dstport 4789 \
    dev eth0
ip link set vxlan10 up

# Step 3 - Create bridge
ip link add br0 type bridge
ip link set br0 up
ip link set eth1 master br0
ip link set vxlan10 master br0
